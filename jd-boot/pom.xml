<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.jaldrishti</groupId>
        <artifactId>jaldrishti-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>jd-boot</artifactId>
    <name>JalDrishti :: Spring Boot Application</name>
    <description>Main executable service wiring all hexagonal adapters, live and sim profiles</description>

    <dependencies>
        <dependency>
            <groupId>org.jaldrishti</groupId>
            <artifactId>jd-domain</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jaldrishti</groupId>
            <artifactId>jd-application</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jaldrishti</groupId>
            <artifactId>jd-adapter-pubsub</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jaldrishti</groupId>
            <artifactId>jd-adapter-rest</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jaldrishti</groupId>
            <artifactId>jd-adapter-persistence</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jaldrishti</groupId>
            <artifactId>jd-adapter-gemini</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jaldrishti</groupId>
            <artifactId>jd-adapter-channels</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jaldrishti</groupId>
            <artifactId>jd-adapter-cap</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jaldrishti</groupId>
            <artifactId>jd-sim</artifactId>
        </dependency>

        <!-- Spring Boot Starters -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!-- Packages scenarios/*.yaml onto the classpath so ScenarioRunEngine can load them
                 both from an IDE/mvn run and from the packaged jar in the Cloud Run container. -->
            <resource>
                <directory>${project.basedir}/../scenarios</directory>
                <targetPath>scenarios</targetPath>
                <excludes>
                    <exclude>golden/**</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
